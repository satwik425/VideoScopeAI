APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=sqlite:///./vidscope.db
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=500

ASR_MODEL_SIZE=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.25

LLM_PROVIDER=groq   # openai, xai or groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
